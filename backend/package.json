{
  "name": "ink-morrow-backend",
  "version": "5.0.0",
  "description": "Backend API for Ink Morrow",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node node_modules/jest/bin/jest.js",
    "test:watch": "node node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node node_modules/jest/bin/jest.js --coverage",
    "auth:reset": "node reset-password.js"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "busboy": "^1.6.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "sharp": "^0.35.4",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "optionalDependencies": {
    "@img/sharp-wasm32": "0.35.4"
  },
  "overrides": {
    "qs": "6.16.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "keywords": [
    "fiction",
    "writing",
    "api"
  ],
  "author": "Ink Morrow",
  "license": "AGPL-3.0-only",
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "server.js"
    ]
  }
}
