# Environment Configuration
# Copy to .env and fill in your OpenRouter API key.

# Required for AI page generation
OPENROUTER_API_KEY=your-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=z-ai/glm-5.1

# Server
PORT=3000
# DB_PATH=../database/scribe-tribe.db    # defaults to ../database/scribe-tribe.db

# AI tuning
# AI_MAX_TOKENS=1500        # max tokens per generated page
# AI_TIMEOUT_MS=120000      # request timeout
# AI_RETRY_BASE_DELAY=800   # base backoff (ms) for transient AI errors
# CONTEXT_WINDOW=5          # recent pages sent verbatim to the AI