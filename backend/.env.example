# Environment Configuration
# Copy to .env and fill in your OpenRouter API key.

# Required for AI page generation
OPENROUTER_API_KEY=your-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=z-ai/glm-5.1

# Server
PORT=3000
# HOST=127.0.0.1    # safe default: only this machine can connect
# DB_PATH=../database/scribe-tribe.db    # defaults to ../database/scribe-tribe.db
# ALLOWED_HOSTS=scribe.example.test      # comma-separated hostnames accepted through a local reverse proxy
# TRUST_PROXY=1                          # trust HTTPS details only from a loopback reverse proxy
# ALLOW_INSECURE_LAN=1                   # explicit opt-in for direct LAN HTTP; passwords/content are not encrypted

# AI tuning
# AI_MAX_TOKENS=1500        # max tokens per generated page
# AI_TIMEOUT_MS=120000      # request timeout
# AI_RETRY_BASE_DELAY=800   # base backoff (ms) for transient AI errors
# CONTEXT_WINDOW=5          # recent pages sent verbatim to the AI
# PAGE_CONTEXT_CHARS=12000  # per-page cap inside prompts (keeps manual giant pages bounded)
# CONTINUITY_MODEL=          # optional cheaper model for page-memory extraction; defaults to the page model

# Image generation (reference portraits, world scenes, scene paintings)
# IMAGE_MODEL=x-ai/grok-imagine-image-2.0   # via OpenRouter's Image API
# IMAGE_TIMEOUT_MS=180000                   # per-image generation timeout
