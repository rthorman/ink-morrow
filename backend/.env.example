# Environment Configuration
# Copy to .env and fill in your OpenRouter API key.

# Read-only credential source for the built-in OpenRouter profile. Reading and
# local story management need no provider. Authenticated APIs support process-session
# credentials and explicitly saved AES-GCM vault credentials.
OPENROUTER_API_KEY=your-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=z-ai/glm-5.1

# Server
PORT=3000
# HOST=127.0.0.1    # safe default: only this machine can connect
# DATA_DIR=../database-v5               # fresh 5.0 database and illustrations
# DB_PATH=../database-v5/ink-morrow-5.db # media follows its directory unless DATA_DIR is set
# Relative paths are resolved from backend/, also by the password-reset command.
# 5.0 refuses older database families without changing their files or sidecars.
# ALLOWED_HOSTS=scribe.example.test      # comma-separated hostnames accepted through a local reverse proxy
# TRUST_PROXY=1                          # trust HTTPS details only from a loopback reverse proxy
# ALLOW_INSECURE_LAN=1                   # explicit opt-in for direct LAN HTTP; passwords/content are not encrypted

# AI tuning
# AI_MAX_TOKENS=1500        # default text output budget
# AI_TIMEOUT_MS=120000      # request timeout
# Fiction calls never automatically retry transport failures.
# Optional consistency quality is Off by default. Configure the memory-support
# role in Settings; choose Standard, Memory or Both in Story preferences.
# Historical CONTINUITY_MODEL does not control the 5.0 runtime or block startup.

# Optional illustrations: configure the Illustrator role in Settings.
# IMAGE_MODEL=x-ai/grok-imagine-image-2.0   # via OpenRouter's Image API
# IMAGE_TIMEOUT_MS=180000                   # per-image generation timeout
