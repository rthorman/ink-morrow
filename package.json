{
  "name": "ink-morrow",
  "version": "4.0.0-beta.1",
  "description": "Interactive fiction writing tool with gothic frontend, world/character reuse, and full test suite",
  "scripts": {
    "start": "cd backend && npm start",
    "setup": "bash setup.sh",
    "lint": "node node_modules/eslint/bin/eslint.js backend frontend e2e",
    "check:brand": "node scripts/check-brand-residue.mjs",
    "check:release": "node scripts/check-release-consistency.mjs",
    "check:docs": "node docs/pdf-library/freshness.mjs",
    "check:docs:strict": "node docs/pdf-library/freshness.mjs --strict",
    "test": "npm run lint && npm run test:setup && npm run test:backend && npm run test:frontend",
    "test:setup": "node scripts/test-setup.mjs",
    "test:backend": "cd backend && npm test",
    "test:frontend": "cd frontend && npm test",
    "test:e2e": "cd e2e && npm test",
    "test:e2e:headed": "cd e2e && npm run test:headed",
    "docs:pdf": "node docs/pdf-library/build.mjs",
    "test:coverage": "cd backend && npm run test:coverage && cd ../frontend && npm run test:coverage"
  },
  "license": "AGPL-3.0-only",
  "private": true,
  "devDependencies": {
    "eslint": "^9.39.5",
    "globals": "^15.15.0"
  }
}
